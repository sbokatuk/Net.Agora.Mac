<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A native AppKit app (not MAUI — MAUI has no net-macos head) that joins a channel and
    publishes/renders video directly against AgoraRtcEngineKit, using the raw Net.Agora.Video.Mac
    binding. It consumes the packed package from ../../artifacts (see NuGet.config), so fetch and
    pack first:
      ./build/fetch-video.sh && ./build/BuildNugets.sh
      dotnet build samples/Net.Agora.Sample.Video.Mac -f net9.0-macos
  -->
  <PropertyGroup>
    <!--
      Pinned macOS platform versions (…-macos15.0), not bare net*-macos. A bare net9.0-macos
      defaults its TargetPlatformVersion to the workload's newest macOS SDK, which demands the exact
      matching Xcode — and CI selects the Xcode for net10.0-macos26.0 (see .github/scripts/
      select-xcode.sh), so a bare net9 leg would fail the app link with "requires Xcode 26.5". The
      pinned 15.0 matches the packed lib/net*-macos15.0 assets and builds under the selected Xcode.
    -->
    <TargetFrameworks>net8.0-macos15.0;net9.0-macos15.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>

    <ApplicationId>com.sbokatuk.agora.mac.sample.video</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>

    <AgoraVideoPackageVersion Condition=" '$(AgoraVideoPackageVersion)' == '' ">$(AgoraVideoMacVersion).$(AgoraVideoBindingRevision)</AgoraVideoPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exact bracketed version so a missing local build fails restore rather than resolving from nuget.org. -->
    <PackageReference Include="Net.Agora.Video.Mac" Version="[$(AgoraVideoPackageVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Info.plist" LogicalName="Info.plist" />
  </ItemGroup>

</Project>
